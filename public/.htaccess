# Morphiic SPA — Apache rewrite rules
# Ensures client-side routes (e.g. /product, /privacy) work on refresh/direct access

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Don't rewrite files or directories that exist (assets, images, .htaccess)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Serve index.html for all other routes (SPA fallback)
  RewriteRule ^ /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Never cache index.html so users always get the latest app version
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Long-cache hashed build assets
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Gzip text-based assets if mod_deflate is available
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
